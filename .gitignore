# Rust
/target/
# Spikes are separate cargo workspaces (see spikes/README.md), so they each have their own
# build directory. Their Cargo.lock files ARE committed — a spike whose measurements cannot be
# reproduced against the same dependency versions is not evidence.
/spikes/**/target/
# Generated by spikes/q2-scene-format/compare.ps1 from the committed candidates. Derived artefacts;
# the README carries the results and the script regenerates them.
/spikes/q2-scene-format/edit-a-tune-a-value/
/spikes/q2-scene-format/edit-b-add-an-entity/
**/*.rs.bk
*.pdb

# Engine artifacts
/.amadeo-cache/          # compiled asset cache
*.ama-snapshot           # world snapshots (transient)
/captures/               # render.capture screenshots

# Replay files are NOT ignored — golden replays are committed test fixtures.
# Ad-hoc recordings go here instead:
/replays-scratch/

# Editor / IDE
.vscode/
.idea/
*.iml

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Profiling output
*.trace
*.chrometrace

# Save files written by a game or by its tests. Where these should actually live is Q38;
# until that is decided they land in the working directory, which is the repository root.
*.save
