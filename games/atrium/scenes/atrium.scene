entity watcher "The watcher"
  Behaviour
    elapsed 0.0
    state ""
  BehaviourMachine
    initial "idle"
    states
      - name "idle"
        transitions
          - after 0.0
            to "pursue"
            unless ""
            when "sees_player"
      - name "pursue"
        transitions
          - after 0.0
            to "search"
            unless "sees_player"
            when ""
      - name "search"
        transitions
          - after 0.0
            to "pursue"
            unless ""
            when "sees_player"
          - after 4.0
            to "idle"
            unless ""
            when ""
  Facts
    known {}
  Mesh
    material "rust"
    mesh "watcher"
  Transform
    rotation 0.0 0.0 0.0
    scale 1.0 1.0 1.0
    translation -7.0 0.8 -7.0
  Watcher

